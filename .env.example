# Copy to .env.local (never commit real values)
GEMINI_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_APP_ENV=development
# Register the web app in Firebase App Check before setting this build-time key.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Enable only after verified client tokens have been observed.
PGR_APP_CHECK_ENFORCE=false
# Public Compliance endpoint: enable only after the production web app is sending valid App Check tokens.
COMPLIANCE_APP_CHECK_ENFORCE=false
# Cloud Run/App Hosting selects Vertex AI with its runtime identity when no API key exists.
PGR_AI_PROVIDER=
# Optional operational assistant. Server-side only; configure through the secret manager.
OPENAI_API_KEY=
# Optional Claude fallback for the S-2220 audit. Server-side only.
ANTHROPIC_API_KEY=
NAI_VERTEX_LOCATION=us
# Explicit model available to the organization's OpenAI project.
OPENAI_MODEL=

# Optional WhatsApp webhook dispatcher. Server-side only.
WHATSAPP_WEBHOOK_URL=
# Comma-separated public HTTPS domains allowed for outbound WhatsApp webhooks.
WHATSAPP_WEBHOOK_ALLOWED_DOMAINS=
