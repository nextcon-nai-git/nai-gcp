# Copy to .env.local (never commit real values)
GEMINI_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_APP_ENV=development
# Register the web app in Firebase App Check before setting this build-time key.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Enable only after verified client tokens have been observed.
PGR_APP_CHECK_ENFORCE=false
# Cloud Run/App Hosting selects Vertex AI with its runtime identity when no API key exists.
PGR_AI_PROVIDER=
