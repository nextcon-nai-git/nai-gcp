rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isNextconOfficial() {
      let user = getUserData();
      return isSignedIn() && user != null && user.role in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS'];
    }

    function belongsToCompany(companyId) {
      let user = getUserData();
      return isSignedIn() && user != null && user.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      let user = getUserData();
      return isSignedIn() && user != null && user.companyId == companyId && user.role in ['SUPER_ADMIN', 'ADMIN', 'CLIENT_ADMIN'];
    }

    function isHealthProfessionalForCompany(companyId) {
      let user = getUserData();
      return isSignedIn() && user != null && user.companyId == companyId && user.role in ['DOCTOR', 'HEALTH_PROFESSIONAL', 'PROVIDER', 'ENGINEER'];
    }

    function isSafeFile() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    function hasClinicalAccess(companyId) {
      let user = getUserData();
      return isSignedIn() && user != null && (
        user.role in ['SUPER_ADMIN', 'ADMIN'] ||
        (user.role in ['DOCTOR', 'NURSE', 'HEALTH_PROFESSIONAL', 'PROVIDER'] &&
          (user.companyId == companyId || ('servedCompanies' in user && user.servedCompanies is list && companyId in user.servedCompanies)))
      );
    }

    function isClinicalImport(category, folderOrFile) {
      return category == 'prontuarios' && folderOrFile == 'importacoes';
    }

    function hasClinicalImportAccess(companyId) {
      let user = getUserData();
      let tenantId = user != null && 'tenantId' in user && user.tenantId is string
        ? user.tenantId
        : user != null && 'companyId' in user && user.companyId is string
          ? user.companyId
          : '';
      return isSignedIn() && user != null && (
        user.role == 'SUPER_ADMIN' ||
        (user.role == 'ADMIN' && tenantId == '') ||
        (user.role in ['ADMIN', 'DOCTOR', 'NURSE', 'HEALTH_PROFESSIONAL'] &&
          (tenantId == companyId || ('servedCompanies' in user && user.servedCompanies is list && companyId in user.servedCompanies)))
      );
    }

    match /clientes/{companyId}/{category}/{folderOrFile}/{allPaths=**} {
      allow read: if isClinicalImport(category, folderOrFile)
        ? hasClinicalImportAccess(companyId)
        : category == 'colaboradores' || category == 'prontuarios'
          ? hasClinicalAccess(companyId)
          : isSignedIn() && (isNextconOfficial() || belongsToCompany(companyId));
      allow create, update: if !isClinicalImport(category, folderOrFile) &&
        (category == 'colaboradores' || category == 'prontuarios'
          ? hasClinicalAccess(companyId)
          : isSignedIn() && (isNextconOfficial() || isCompanyAdmin(companyId) || isHealthProfessionalForCompany(companyId))) && isSafeFile();
      allow delete: if !isClinicalImport(category, folderOrFile) &&
        (category == 'colaboradores' || category == 'prontuarios'
          ? isSignedIn() && getUserData().role == 'SUPER_ADMIN'
          : isSignedIn() && (isNextconOfficial() || isCompanyAdmin(companyId)));
    }

    match /internos_nextcon/{allPaths=**} {
      allow read: if isNextconOfficial();
      allow create, update: if isNextconOfficial() && isSafeFile();
      allow delete: if isNextconOfficial();
    }

    match /public/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
