{
  "hosting": {
    "source": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "frameworksBackend": {
      "region": "us-central1"
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions/audit-s2220",
      "codebase": "s2220-audit",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$PROJECT_DIR\" run build:s2220-function"]
    }
  ]
}
