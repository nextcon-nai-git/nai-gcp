              "after": "    try {\n      const existing = await fs.lstat(dest)\n      if (existing.isSymbolicLink()) throw new Error('Archive target is a symlink')\n    } catch (error) {\n      if (error.code !== 'ENOENT') throw error\n    }\n    await pipeline(readStream, createWriteStream(dest, {\n      mode: procMode,\n      flags: constants.O_WRONLY | constants.O_CREAT | constants.O_TRUNC | (constants.O_NOFOLLOW || 0)\n    }))"
