rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isNextconOfficial() {
      let profile = getUserProfile();
      return isSignedIn() && profile != null && profile.role in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS'];
    }

    function belongsToCompany(companyId) {
      let profile = getUserProfile();
      return isSignedIn() && profile != null && profile.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      let profile = getUserProfile();
      return isSignedIn() && profile != null && profile.companyId == companyId && profile.role in ['SUPER_ADMIN', 'ADMIN', 'CLIENT_ADMIN'];
    }

    function isHealthProfessionalForCompany(companyId) {
      let profile = getUserProfile();
      return isSignedIn() && profile != null && profile.companyId == companyId && profile.role in ['DOCTOR', 'HEALTH_PROFESSIONAL', 'PROVIDER', 'ENGINEER'];
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSecurityAdmin() {
      return isSignedIn() && getUserProfile().role == 'SUPER_ADMIN';
    }

    function hasClinicalAccess(companyId) {
      let profile = getUserProfile();
      return isSignedIn() && profile != null && (
        profile.role in ['SUPER_ADMIN', 'ADMIN'] ||
        (profile.role in ['DOCTOR', 'NURSE', 'HEALTH_PROFESSIONAL', 'PROVIDER'] &&
          (profile.companyId == companyId || ('servedCompanies' in profile && profile.servedCompanies is list && companyId in profile.servedCompanies)))
      );
    }

    function isClinicalCollection(name) {
      return name in ['aso_attendances', 'medical_records', 'clinical_records', 'prontuarios', 'medical_certificates'];
    }

    function userSelfManagedCreateKeysAreValid(userId) {
      return request.resource.data.keys().hasOnly(['id', 'email', 'name', 'updatedAt', 'crm', 'rqe', 'certificate_info'])
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email;
    }

    function userSelfManagedUpdateKeysAreValid() {
      // affectedKeys includes additions, modifications and deletions. Fields
      // outside this allowlist stay immutable even on an unprovisioned profile.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt', 'crm', 'rqe', 'certificate_info']);
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (belongsToCompany(companyId) || isNextconOfficial());
      allow write: if isCompanyAdmin(companyId);
    }

    // The dashboard aggregates operational tasks across companies. Collection
    // group queries need an explicit recursive match; tenant queries keep their
    // existing company-scoped rules. This grants no additional write access.
    match /{path=**}/tasks/{taskId} {
      allow list: if isNextconOfficial();
    }

    match /companies/{companyId}/{subcollection}/{document=**} {
      allow read: if isClinicalCollection(subcollection)
        ? hasClinicalAccess(companyId)
        : isSignedIn() && (belongsToCompany(companyId) || isNextconOfficial());
      allow create, update: if isClinicalCollection(subcollection)
        ? hasClinicalAccess(companyId)
        : isCompanyAdmin(companyId) || isNextconOfficial();
      allow delete: if isClinicalCollection(subcollection)
        ? isSecurityAdmin()
        : isCompanyAdmin(companyId) || isNextconOfficial();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isNextconOfficial() || belongsToCompany(resource.data.companyId));
      allow create: if (isSelf(userId) && userSelfManagedCreateKeysAreValid(userId)) || isSecurityAdmin();
      allow update: if (isSelf(userId) && userSelfManagedUpdateKeysAreValid()) || isSecurityAdmin() ||
        ((isNextconOfficial() || isCompanyAdmin(resource.data.companyId)) && userSelfManagedUpdateKeysAreValid());
      allow delete: if isSecurityAdmin();
    }

    match /documents/{documentId} {
      allow read: if isSignedIn() && (
        isNextconOfficial() ||
        belongsToCompany(resource.data.companyId) ||
        isHealthProfessionalForCompany(resource.data.companyId)
      );
      allow create: if isSignedIn() && (
        isNextconOfficial() ||
        isCompanyAdmin(request.resource.data.companyId) ||
        isHealthProfessionalForCompany(request.resource.data.companyId)
      );
      allow update, delete: if isSignedIn() && (
        isNextconOfficial() ||
        isCompanyAdmin(resource.data.companyId)
      );
    }

    match /config_nai_avatar/{docId} {
      allow read: if isSignedIn();
      allow write: if isNextconOfficial();
    }

    match /relatorios_sst/{reportId} {
      allow read: if isSignedIn() && (
        isNextconOfficial() ||
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isSignedIn() && (
        isNextconOfficial() ||
        isCompanyAdmin(request.resource.data.companyId) ||
        isHealthProfessionalForCompany(request.resource.data.companyId)
      );
      allow update, delete: if isSignedIn() && (isNextconOfficial() || isCompanyAdmin(resource.data.companyId));
    }

    match /analisesPGR/{docId} {
      allow read: if isSignedIn() && (
        isNextconOfficial() ||
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isSignedIn() && (
        isNextconOfficial() ||
        isCompanyAdmin(request.resource.data.companyId) ||
        isHealthProfessionalForCompany(request.resource.data.companyId)
      );
      allow update, delete: if isSignedIn() && (isNextconOfficial() || isCompanyAdmin(resource.data.companyId));
    }

    match /{rootCollection}/{document=**} {
      allow read: if isSignedIn() && isNextconOfficial() && rootCollection != 'companies';
      allow write: if isNextconOfficial() && !(rootCollection in ['users', 'companies', 'integrations']);
    }
  }
}
